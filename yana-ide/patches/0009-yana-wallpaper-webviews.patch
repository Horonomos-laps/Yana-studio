+	/** Yana: khi hình nền bật, nền trang trong webview Yana trong suốt để cảnh liền một lớp. */
+	private _yanaWallpaperStyles(theme: IWorkbenchColorTheme): Record<string, string> {
+		const wallpaper = this._configurationService.getValue<string>('yana.wallpaper.theme');
+		const highContrast = theme.type === ColorScheme.HIGH_CONTRAST_DARK || theme.type === ColorScheme.HIGH_CONTRAST_LIGHT;
