+			return {};
+		}
+		// Khung thẻ đặc hơn nền trang, và đi theo cùng thanh "độ hiện" của người dùng.
+		const visibility = Math.min(80, Math.max(10, this._configurationService.getValue<number>('yana.wallpaper.visibility') ?? 35));
+		const card = Math.round((100 - visibility) * 0.7);
+		const scene = resolveWallpaper(wallpaper ?? 'auto', theme.type);
+		const recolor = this._configurationService.getValue<boolean>('yana.wallpaper.recolor') !== false;
+		const colours = scene && recolor ? wallpaperColors(scene, theme.type) : {};
+		return { ...colours, 'vscode-yana-wallpaper-body': '0%', 'vscode-yana-wallpaper-card': card + '%' };
+	}
